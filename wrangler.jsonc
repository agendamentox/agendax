{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agendax",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agendax-db",
      "database_id": "c0d1067a-4be3-43a3-8607-97687153468d"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
